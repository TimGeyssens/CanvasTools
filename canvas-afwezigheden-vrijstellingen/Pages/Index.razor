    private async Task HandleFileSelected(InputFileChangeEventArgs e)
    {
        errorMessage = null;
        absences = null;
        
        try
        {
            var file = e.File;
            if (file != null)
            {
                using var stream = file.OpenReadStream(maxAllowedSize: 10 * 1024 * 1024); // 10MB max
                using var memoryStream = new MemoryStream();
                await stream.CopyToAsync(memoryStream);
                memoryStream.Position = 0;
                
                absences = await ExcelService.ReadAbsencesFromExcel(memoryStream);

                // If roster already loaded, attach section names
                AttachSectionNamesToAbsences();
                
                // Recalculate unjustified absences if attendance records exist
                if (attendanceRecords != null)
                {
                    await CalculateUnjustifiedAbsencesAsync();
                }
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Error reading Excel file: {ex.Message}";
        }
    }

    private async Task HandleAttendanceFileSelected(InputFileChangeEventArgs e)
    {
        errorMessage = null;
        
        // Initialize attendanceRecords list if this is the first upload
        if (attendanceRecords == null)
        {
            attendanceRecords = new List<Attendance>();
            attendanceFilesUploaded = 0;
        }
        
        try
        {
            var files = e.GetMultipleFiles(maximumFileCount: 50);
            var newRecordsCount = 0;
            
            foreach (var file in files)
            {
                using var stream = file.OpenReadStream(maxAllowedSize: 10 * 1024 * 1024); // 10MB max
                using var memoryStream = new MemoryStream();
                await stream.CopyToAsync(memoryStream);
                memoryStream.Position = 0;
                
                var newRecords = await ExcelService.ReadAttendanceFromExcel(memoryStream);
                attendanceRecords.AddRange(newRecords);
                newRecordsCount += newRecords.Count;
                attendanceFilesUploaded++;
            }
            
            // Calculate unjustified absences after adding all new records
            await CalculateUnjustifiedAbsencesAsync();
        }
        catch (Exception ex)
        {
            errorMessage = $"Error reading attendance file(s): {ex.Message}";
        }
    }
    
