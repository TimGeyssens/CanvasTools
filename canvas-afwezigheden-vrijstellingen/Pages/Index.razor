    private static string NormalizeStudentKey(string? value)
    {
        if (string.IsNullOrWhiteSpace(value))
            return string.Empty;

        var trimmed = value.Trim();
        var chars = trimmed
            .Where(c => !char.IsWhiteSpace(c) && System.Globalization.CharUnicodeInfo.GetUnicodeCategory(c) != System.Globalization.UnicodeCategory.Format)
            .ToArray();
        return new string(chars).ToLowerInvariant();
    }

    private static string[] GetNameTokens(string? value)
    {
        if (string.IsNullOrWhiteSpace(value))
            return Array.Empty<string>();

        // Normalize names so "Last First" and "First Last" match:
        // - lowercase
        // - remove diacritics and format chars
        // - keep only letters/digits (others become separators)
        // - drop purely numeric tokens (e.g., "202445753")
        // - sort tokens
        var lower = value.Trim().ToLowerInvariant().Normalize(System.Text.NormalizationForm.FormD);
        var sb = new System.Text.StringBuilder();

        foreach (var c in lower)
        {
            var cat = System.Globalization.CharUnicodeInfo.GetUnicodeCategory(c);
            if (cat == System.Globalization.UnicodeCategory.NonSpacingMark || cat == System.Globalization.UnicodeCategory.Format)
                continue;

            if (char.IsLetterOrDigit(c))
                sb.Append(c);
            else
                sb.Append(' ');
        }

        return sb
            .ToString()
            .Split(' ', StringSplitOptions.RemoveEmptyEntries)
            .Where(t => t.Length > 1)
            .Where(t => !t.All(char.IsDigit))
            .OrderBy(t => t, StringComparer.Ordinal)
            .ToArray();
    }

    private static string NormalizeNameKey(string? value)
    {
        return string.Join(' ', GetNameTokens(value));
    }

    private static string NormalizeNameKeyFirstLast(string? value)
    {
        var tokens = GetNameTokens(value);
        if (tokens.Length == 0)
            return string.Empty;
        if (tokens.Length == 1)
            return tokens[0];

        // first+last, order-insensitive
        var first = tokens.First();
        var last = tokens.Last();
        return string.Join(' ', new[] { first, last }.OrderBy(t => t, StringComparer.Ordinal));
    }

    private static string NormalizeIdAsNameKey(string? studentId)
    {
        if (string.IsNullOrWhiteSpace(studentId))
            return string.Empty;

        // Convert IDs like "andres.fonteyne" to a comparable name key.
        var s = studentId.Trim().ToLowerInvariant();
        s = s.Replace('.', ' ').Replace('_', ' ').Replace('-', ' ');
        return NormalizeNameKey(s);
    }

    private static string NormalizeIdAsNameKeyFirstLast(string? studentId)
    {
        if (string.IsNullOrWhiteSpace(studentId))
            return string.Empty;

        var s = studentId.Trim().ToLowerInvariant();
        s = s.Replace('.', ' ').Replace('_', ' ').Replace('-', ' ');
        return NormalizeNameKeyFirstLast(s);
    }

    private async Task<List<UnjustifiedAbsence>> GetUnjustifiedAbsencesAsync()
    {
        if (attendanceRecords == null)
            return new List<UnjustifiedAbsence>();

        var justifiedAbsences = absences ?? new List<Absence>();

        // Matrix-style exports explicitly mark absence (Present=false)
        if (attendanceRecords.Any(a => !a.Present))
        {
            return ExcelService.FindUnjustifiedAbsences(attendanceRecords, justifiedAbsences);
        }

        // Present-only exports (e.g., Microsoft Forms list of attendees): infer absences from Canvas roster.
        // For safety/clarity, require the user to load the roster explicitly.
        if (courseId == 0 || students == null || students.Count == 0)
            return new List<UnjustifiedAbsence>();

        var unjustified = new List<UnjustifiedAbsence>();
        var dates = attendanceRecords.Select(a => a.Date.Date).Distinct().ToList();

        foreach (var date in dates)
        {
            var presentEmailKeys = attendanceRecords
                .Where(a => a.Date.Date == date && a.Present)
                .Select(a => NormalizeStudentKey(a.StudentId))
                .Where(id => !string.IsNullOrWhiteSpace(id))
                .ToHashSet(StringComparer.OrdinalIgnoreCase);

            // Build name-key sets from attendance for matching against Canvas roster
            var presentNameKeys = new HashSet<string>(StringComparer.OrdinalIgnoreCase);
            foreach (var a in attendanceRecords.Where(a => a.Date.Date == date && a.Present))
            {
                var full = NormalizeNameKey(a.StudentName);
                var firstLast = NormalizeNameKeyFirstLast(a.StudentName);

                if (!string.IsNullOrWhiteSpace(full))
                    presentNameKeys.Add(full);
                if (!string.IsNullOrWhiteSpace(firstLast))
                    presentNameKeys.Add(firstLast);
            }

            var justifiedIdKeys = justifiedAbsences
                .Where(a => a.AbsenceDate.Date == date)
                .Select(a => NormalizeStudentKey(a.StudentId))
                .Where(id => !string.IsNullOrWhiteSpace(id))
                .ToHashSet(StringComparer.OrdinalIgnoreCase);

            var justifiedNameKeys = new HashSet<string>(StringComparer.OrdinalIgnoreCase);
            foreach (var a in justifiedAbsences.Where(a => a.AbsenceDate.Date == date))
            {
                var full = NormalizeNameKey(a.StudentName);
                var firstLast = NormalizeNameKeyFirstLast(a.StudentName);

                if (!string.IsNullOrWhiteSpace(full))
                    justifiedNameKeys.Add(full);
                if (!string.IsNullOrWhiteSpace(firstLast))
                    justifiedNameKeys.Add(firstLast);
            }

            foreach (var s in students)
            {
                var rosterEmailPrefix = (!string.IsNullOrWhiteSpace(s.Email) && s.Email.Contains('@'))
                    ? NormalizeStudentKey(s.Email.Split('@')[0])
                    : string.Empty;

                var rosterNameKey = NormalizeNameKey(s.StudentName);
                var rosterNameFirstLast = NormalizeNameKeyFirstLast(s.StudentName);

                var rosterIdAsName = NormalizeIdAsNameKey(s.StudentId);
                var rosterIdAsNameFirstLast = NormalizeIdAsNameKeyFirstLast(s.StudentId);

                var isPresent = (!string.IsNullOrWhiteSpace(rosterEmailPrefix) && presentEmailKeys.Contains(rosterEmailPrefix))
                                || (!string.IsNullOrWhiteSpace(rosterNameKey) && presentNameKeys.Contains(rosterNameKey))
                                || (!string.IsNullOrWhiteSpace(rosterNameFirstLast) && presentNameKeys.Contains(rosterNameFirstLast))
                                || (!string.IsNullOrWhiteSpace(rosterIdAsName) && presentNameKeys.Contains(rosterIdAsName))
                                || (!string.IsNullOrWhiteSpace(rosterIdAsNameFirstLast) && presentNameKeys.Contains(rosterIdAsNameFirstLast));

                if (isPresent)
                    continue;

                // not present => absent; now exclude "gewettigd" students
                var isJustified = (!string.IsNullOrWhiteSpace(rosterEmailPrefix) && justifiedIdKeys.Contains(rosterEmailPrefix))
                                  || (!string.IsNullOrWhiteSpace(rosterNameKey) && justifiedNameKeys.Contains(rosterNameKey))
                                  || (!string.IsNullOrWhiteSpace(rosterNameFirstLast) && justifiedNameKeys.Contains(rosterNameFirstLast));

                if (isJustified)
                    continue;

                // Use a Canvas-searchable key for later updates.
                // Prefer roster email prefix; otherwise fall back to whatever id we got from Canvas.
                var keyForCanvas = !string.IsNullOrWhiteSpace(rosterEmailPrefix)
                    ? rosterEmailPrefix
                    : NormalizeStudentKey(s.StudentId);

                if (string.IsNullOrWhiteSpace(keyForCanvas))
                    continue;

                unjustified.Add(new UnjustifiedAbsence
                {
                    StudentId = keyForCanvas,
                    StudentName = s.StudentName,
                    Date = date,
                    SectionName = s.SectionName
                });
            }
        }

        return unjustified;
    }

