    {
        if (unjustifiedAbsences == null || unjustifiedAbsences.Count == 0 || courseId == 0 || assignments == null)
            return;

        isProcessing = true;
        errorMessage = null;
        results = null;

        try
        {
            results = await CanvasService.ProcessZeros(courseId, unjustifiedAbsences, assignments, simulate);
        }
        catch (Exception ex)
        {
            errorMessage = $"Error applying zeros: {ex.Message}";
        }
        finally
        {
            isProcessing = false;
        }
    }

    private async Task ApplyExemptionsAndZeros(bool simulate)
    {
        if (absences == null || absences.Count == 0 || attendanceRecords == null || attendanceRecords.Count == 0 || courseId == 0 || assignments == null)
            return;

        isProcessing = true;
        errorMessage = null;
        results = null;

        try
        {
            // Ensure we have an up-to-date unjustified list based on current attendance + justified absences
            var localUnjustified = await GetUnjustifiedAbsencesAsync();

            var exemptionResults = await CanvasService.ProcessExemptions(courseId, absences, assignments, simulate);
            var zeroResults = localUnjustified.Count > 0
                ? await CanvasService.ProcessZeros(courseId, localUnjustified, assignments, simulate)
                : new List<ExemptionResult>();

            // Prefix messages so the combined results table is easy to scan
            foreach (var r in exemptionResults)
            {
                r.Message = $"[EXEMPTION] {r.Message}";
            }
            foreach (var r in zeroResults)
            {
                r.Message = $"[ZERO] {r.Message}";
            }

            results = new List<ExemptionResult>();
            results.AddRange(exemptionResults);
            results.AddRange(zeroResults);
        }
        catch (Exception ex)
        {
            errorMessage = $"Error processing exemptions/zeros: {ex.Message}";
        }
        finally
        {
            isProcessing = false;
        }
    }

